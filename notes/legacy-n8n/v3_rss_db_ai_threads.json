        "jsCode": "// 스레드 설정 및 뉴스 데이터 통합\nconst tokenData = $('get-threads-token').all()[0]?.json;\nconst newsData = $('get-news-for-threads').all();\n\nif (!tokenData || newsData.length === 0) {\n  return [];\n}\n\nreturn [{\n  json: {\n    access_token: tokenData.Token,\n    thread_id: \"24197616939918667\",\n    newsData: newsData.slice(0, 5).map(item => item.json) // 최대 5개\n  }\n}];"
