        "messages": {
          "values": [
            {
              "content": "=다음 뉴스들을 30-70자 내로 요약하고, 디스코드 메시지를 생성해주세요:\n\n{{ JSON.stringify($json.data, null, 2) }}\n\n요구사항:\n1. 각 뉴스별 핵심 요약 (30-70자)\n2. 디스코드 메시지 형식으로 포맷팅\n3. 마크다운 및 이모지 활용\n4. 썸네일 미리보기를 위한 URL 처리\n\n다음 JSON 형식으로 응답:\n{\n  \"summaries\": [\n    {\"link\": \"URL\", \"summary\": \"요약문\"}\n  ],\n  \"discordMessage\": \"마크다운 형식의 완성된 메시지\"\n}"
            }
          ]
        }
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1,
      "position": [
        -1000,
        560
      ],
      "id": "generate-summaries-and-message",
      "name": "요약 및 메시지 생성",
      "credentials": {
        "googlePalmApi": {
          "id": "VkwMNsi2swBIrPyt",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Gemini 응답 파싱\nconst rawResponse = $json.content?.parts?.[0]?.text || '';\nlet parsed;\n\ntry {\n  parsed = JSON.parse(rawResponse.replace(/```json|```/g, '').trim());\n} catch (err) {\n  throw new Error('AI 응답 파싱 실패: ' + err.message);\n}\n\n// 요약 업데이트를 위한 개별 아이템과 디스코드 메시지 반환\nconst results = [];\n\n// 각 요약에 대한 업데이트 아이템\nif (parsed.summaries) {\n  parsed.summaries.forEach(summary => {\n    results.push({\n      json: {\n        type: 'summary_update',\n        link: summary.link,\n        summary: summary.summary\n      }\n    });\n  });\n}\n\n// 디스코드 메시지 아이템\nif (parsed.discordMessage) {\n  results.push({\n    json: {\n      type: 'discord_message',\n      message: parsed.discordMessage\n    }\n  });\n}\n\nreturn results;"
      },
