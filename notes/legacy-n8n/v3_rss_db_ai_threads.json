      "parameters": {
        "jsCode": "// 키워드 기반 필터링 및 최적화된 뉴스 선별\nconst items = $input.all();\n\nconst excludeKeywords = [\n  '부고', '인사', '공지', '모집', '채용', '입찰', \n  '알림', '안내', '변경', '연기', '취소',\n  '날씨', '교통', '부동산', '주식'\n];\n\nconst priorityKeywords = [\n  '전시', '공연', '콘서트', '뮤지컬', '연극', '영화', '오페라', '발레', '무용',\n  '리사이탈', '갈라', '쇼케이스', '프리미어', '초연', '재공연',\n  '축제', '페스티벌', '개막', '폐막', '시상', '어워드', '공모전', '비엔날레',\n  '예술의전당', '국립', '세종문화회관', 'K-컬처', '한류', '문화예술'\n];\n\n// 필터링 및 점수 계산\nconst processedItems = items\n  .filter(item => {\n    const title = (item.json.title || '').toLowerCase();\n    return !excludeKeywords.some(keyword => title.includes(keyword.toLowerCase()));\n  })\n  .map(item => {\n    const title = item.json.title.toLowerCase();\n    const priorityScore = priorityKeywords.filter(keyword => \n      title.includes(keyword.toLowerCase())\n    ).length;\n    \n    return {\n      json: {\n        title: item.json.title,\n        link: item.json.link,\n        pubDate: item.json.pubDate,\n        content: item.json.contentSnippet || item.json.content || '',\n        priorityScore,\n        // 중복 제거를 위한 해시 생성\n        titleHash: item.json.title.replace(/[^가-힣a-zA-Z0-9]/g, '').substring(0, 50)\n      }\n    };\n  })\n  .sort((a, b) => b.json.priorityScore - a.json.priorityScore)\n  .slice(0, 30); // 상위 30개만 선택\n\n// 중복 제거 (제목 기반)\nconst uniqueItems = [];\nconst seenTitles = new Set();\n\nfor (const item of processedItems) {\n  if (!seenTitles.has(item.json.titleHash)) {\n    seenTitles.add(item.json.titleHash);\n    uniqueItems.push(item);\n    if (uniqueItems.length >= 20) break; // 최대 20개\n  }\n}\n\nreturn uniqueItems;"
      },
