        "jsCode": "// 선별된 뉴스의 본문 요약 및 이미지 URL 추출을 병렬로 처리\nconst items = $input.all();\n\nreturn items.map(item => {\n  return {\n    json: {\n      title: item.json.title,\n      link: item.json.link,\n      pubDate: item.json.pubDate,\n      needsProcessing: true\n    }\n  };\n});"
