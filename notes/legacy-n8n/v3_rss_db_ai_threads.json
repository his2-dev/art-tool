    {
      "parameters": {
        "jsCode": "// 본문 요약 및 이미지 URL 추출을 한 번에 처리\nconst html = $json.data;\n\n// 이미지 URL 추출\nconst imageMatch = html.match(/<meta property=\"og:image\" content=\"([^\"]+)\"\\s*\\/?>/i);\nconst imageUrl = imageMatch ? imageMatch[1] : null;\n\n// 본문 텍스트 추출 (간단한 HTML 태그 제거)\nconst textContent = html\n  .replace(/<script[^>]*>.*?<\\/script>/gi, '')\n  .replace(/<style[^>]*>.*?<\\/style>/gi, '')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .substring(0, 500); // 첫 500자만\n\nreturn [{\n  json: {\n    title: $('prepare-content-extraction').item.json.title,\n    link: $('prepare-content-extraction').item.json.link,\n    pubDate: $('prepare-content-extraction').item.json.pubDate,\n    content: textContent,\n    imageUrl: imageUrl\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1400,
        560
      ],
